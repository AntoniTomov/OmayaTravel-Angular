{
  "name": "website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "start:amelia": "ng serve --port 4200",
    "build": "ng build --progress=false",
    "build:amelia": "ng build --progress=false --configuration production,amelia --output-path dist/website-amelia",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --progress=false",
    "serve:ssr:website": "node dist/website/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
